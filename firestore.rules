rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // --- users ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Signup can set any role except "admin" — that must only ever be
      // granted directly in Firestore (see scripts/make-admin.mjs).
      allow create: if isOwner(userId)
        && request.resource.data.role != 'admin'
        && (!('status' in request.resource.data) || request.resource.data.status == 'Active');

      // A user can update their own profile but not their own role or
      // suspension status — only an admin can change those.
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('status', 'Active') == resource.data.get('status', 'Active')
      );

      allow delete: if false;

      match /favorites/{clipId} {
        allow read, write: if isOwner(userId);
      }

      // Social accounts a creator links (handles, and OAuth tokens where a platform
      // uses OAuth) — see src/lib/socials.ts, one doc per platform.
      match /socials/{platform} {
        allow read, write: if isOwner(userId);
      }

      // Payout details a creator enters themselves (bank + wallet address) — see
      // src/lib/creator-payout.ts. Financial info, so kept just as tightly scoped as
      // the OAuth token docs: only the owner (or an admin, for actually paying out).
      match /payout/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- clips ---
    match /clips/{clipId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && (
          request.resource.data.status == 'pending'
          // Only allowed when the platform-wide auto-moderation setting is actually
          // on — this reads the real server-side value, not the client's request, so
          // a tampered client can't self-approve by just changing what it sends.
          || (
            request.resource.data.status == 'approved'
            && get(/databases/$(database)/documents/settings/public).data.autoModeration == true
          )
        );

      // Only moderation (approve/reject) can change a clip afterward — admin always,
      // or the brand behind the campaign this clip was submitted to (if any).
      allow update: if onlyChanged(['status']) && (
        isAdmin()
        || (
          isSignedIn() && 'campaignId' in resource.data
          && get(/databases/$(database)/documents/campaigns/$(resource.data.campaignId)).data.brandId == request.auth.uid
        )
      );

      allow delete: if false;
    }

    // --- campaigns ---
    match /campaigns/{campaignId} {
      // Any signed-in user can read an active campaign — creators need to browse the
      // open ones to submit clips (see /dashboard/competitions, the creator-facing
      // campaigns feed). A non-active (e.g. future draft) campaign stays visible only
      // to its owning brand and admins.
      allow read: if isSignedIn()
        && (isAdmin() || resource.data.brandId == request.auth.uid || resource.data.status == 'active');

      allow create: if isSignedIn() && request.resource.data.brandId == request.auth.uid;

      allow update: if isAdmin() || (isSignedIn() && resource.data.brandId == request.auth.uid);

      allow delete: if false;
    }

    // --- transactions (payment attempt ledger — both successful and failed) ---
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // A payment record is a fact of what happened — never edited or removed
      // afterward, by anyone (including admins).
      allow update, delete: if false;
    }

    // --- notifications ---
    // One doc per notification, recipient in `userId`. Written by whoever's action
    // triggered it (a creator submitting a clip notifies the brand; a brand/admin
    // resolving a clip notifies the creator) rather than the recipient themselves, so
    // create has to verify the write actually corresponds to a real action on a real
    // campaign/clip instead of trusting the client's claimed userId/type outright.
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if onlyChanged(['read']) && isOwner(resource.data.userId);
      allow delete: if false;

      allow create: if isSignedIn() && (
        isAdmin()
        || (
          // A creator notifying the brand that they submitted a clip to one of the
          // brand's own campaigns. Tied to the clip the requesting user just created
          // (not just the claimed userId/campaignId) so another signed-in account can't
          // spam a brand with fabricated submission notifications.
          request.resource.data.type == 'clip_submitted'
          && get(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.brandId == request.resource.data.userId
          && get(/databases/$(database)/documents/clips/$(request.resource.data.clipId)).data.creatorId == request.auth.uid
          && get(/databases/$(database)/documents/clips/$(request.resource.data.clipId)).data.campaignId == request.resource.data.campaignId
        )
        || (
          // The brand notifying a creator that their clip to one of the brand's own
          // campaigns was approved/rejected (admin doing the same is covered above).
          (request.resource.data.type == 'clip_approved' || request.resource.data.type == 'clip_rejected')
          && get(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.brandId == request.auth.uid
          && get(/databases/$(database)/documents/clips/$(request.resource.data.clipId)).data.creatorId == request.resource.data.userId
        )
        || (
          // The brand notifying themselves that one of their own campaigns ran out of
          // budget.
          request.resource.data.type == 'budget_exhausted'
          && request.resource.data.userId == request.auth.uid
          && get(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.brandId == request.auth.uid
        )
      );
    }

    // --- platform settings ---
    // Full config, including payment-provider secret keys — admin only,
    // never readable by a regular signed-in user.
    match /settings/platform {
      allow read, write: if isAdmin();
    }

    // Derived, non-secret subset (fees, which providers are live, moderation/
    // maintenance toggles) that checkout and the login/signup flow read from. Public
    // read (not just isSignedIn()) is intentional: nothing in this doc is sensitive —
    // provider "public" keys are safe by design — and maintenanceMode/autoModeration
    // need to be readable before a visitor is signed in at all.
    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
