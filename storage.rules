rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Campaign flyer images — src/lib/firebase-helpers.ts uploadCampaignFlyer()
    match /campaign-flyers/{brandId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == brandId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Clip video uploads — src/lib/clips.ts uploadClipVideo()
    match /clips/{creatorId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == creatorId
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }
  }
}
